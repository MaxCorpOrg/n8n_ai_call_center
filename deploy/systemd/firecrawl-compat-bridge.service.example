[Unit]
Description=Firecrawl Compatible Bridge
After=network-online.target firecrawl-playwright.service
Wants=network-online.target

[Service]
Type=simple
User=aicore
WorkingDirectory=/home/aicore/n8n-server
Environment=FIRECRAWL_COMPAT_HOST=127.0.0.1
Environment=FIRECRAWL_COMPAT_PORT=3002
Environment=FIRECRAWL_PLAYWRIGHT_URL=http://127.0.0.1:3003/scrape
ExecStart=/usr/bin/python3 /home/aicore/n8n-server/scripts/firecrawl_compat_bridge.py --host 127.0.0.1 --port 3002 --playwright-url http://127.0.0.1:3003/scrape
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
