[Unit]
Description=Site Control Kit browser client for cosmetologist hunter
After=network.target site-control-kit-hub.service
Requires=site-control-kit-hub.service

[Service]
Type=simple
User=aicore
WorkingDirectory=/home/aicore/n8n-server
Environment=SITECTL_ROOT=/home/aicore/agent-tools/site-control-kit
Environment=SITECTL_HUB_ENV=/etc/site-control-kit/hub.env
Environment=SITECTL_HUB_URL=http://127.0.0.1:8765
Environment=SITECTL_BROWSER_RUNTIME_ROOT=/home/aicore/.local/share/site-control-kit-browser
Environment=SITECTL_BROWSER_CLIENT_ID=client-cosmetologist-browser
Environment=SITECTL_BROWSER_DISPLAY=:99
Environment=SITECTL_BROWSER_START_URL=about:blank
ExecStart=/home/aicore/n8n-server/scripts/run_site_control_browser_client.sh
Restart=on-failure
RestartSec=5
RuntimeMaxSec=15m
