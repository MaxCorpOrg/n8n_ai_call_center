[Unit]
Description=Site Control Kit Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aicore
WorkingDirectory=/home/aicore/agent-tools/site-control-kit
EnvironmentFile=-/etc/site-control-kit/hub.env
ExecStart=/home/aicore/agent-tools/site-control-kit/.venv/bin/python -m webcontrol serve --host ${SITECTL_HOST} --port ${SITECTL_PORT} --token ${SITECTL_TOKEN} --state-file ${SITECTL_STATE_FILE}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
