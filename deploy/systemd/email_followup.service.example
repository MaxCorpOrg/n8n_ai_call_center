[Unit]
Description=Email Followup Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=max
WorkingDirectory=/home/max/n8n_ai_call_center
ExecStart=/home/max/n8n_ai_call_center/scripts/run_email_followup_service.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
