# Агент обзвона (RAG + QA loop)
AGENT_CODE=lipolong_b2b_ru_v1
AGENT_LANGUAGE=ru

# База данных агента (рекомендуется postgres_memory)
AGENT_DB_SERVICE=postgres_memory
AGENT_DB_NAME=n8n_memory
AGENT_DB_USER=n8n_memory
AGENT_DB_PASSWORD=change_me
AGENT_DB_PORT=5432

# LLM провайдер (любой)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace_me
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=8000

# Параметры поиска знаний
RAG_TOP_K=6
RAG_MIN_RELEVANCE=0.12
RAG_MAX_CHARS=4500

# Внешнее хранилище клиентских данных (PII)
CLIENT_SOURCE_SYSTEM=google_sheets
CLIENT_SOURCE_LOCATOR=gdrive://replace_with_file_or_sheet_id
GOOGLE_DRIVE_FOLDER_ID=replace_me
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/gdrive_service_account.json

# Политика приватности памяти
MEMORY_STORE_PII=false
MEMORY_REDACT_PII=true
MEMORY_CLIENT_REF_SALT=replace_me_with_random_salt

# Политика обзвона
CALL_MAX_ATTEMPTS=3
CALL_RETRY_HOURS=72
CALL_ALLOWED_HOURS_FROM=10
CALL_ALLOWED_HOURS_TO=19
CALL_TIMEZONE=Europe/Moscow

# Качество и обучение
QA_AUTOSCORE_ENABLED=true
QA_AUTOSCORE_THRESHOLD=75
TRAINING_AUTO_APPROVE=false
TRAINING_REVIEWER=manager
