# VPS public IP where Asterisk listens
PUBLIC_IP=1.2.3.4

# Mango gateway/source IP (ask Mango support for your exact SIP source IP if needed)
MANGO_IP=81.88.86.55

# ElevenLabs SIP endpoint
ELEVEN_SIP_HOST=sip.rtc.elevenlabs.io
ELEVEN_SIP_PORT=5060

# Quick route mode: Mango sends extension 100, bridge forwards to this number
TARGET_NUMBER_E164=+79923298897
BRIDGE_EXT=100

# Local SIP listen settings
BIND_IP=0.0.0.0
BIND_PORT=5060

# RTP range
RTP_START=10000
RTP_END=20000
