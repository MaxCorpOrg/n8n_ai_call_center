# n8n API access (for scripts/import_workspace.sh)
N8N_BASE_URL=https://your-n8n-domain
N8N_API_KEY=replace_n8n_public_api_key

# Provider keys to replace inside workflows after import
KLING_API_KEY=replace_kling_api_key
TAVILY_API_KEY=replace_tavily_api_key
GEMINI_API_KEY=replace_gemini_api_key

# Optional
ACTIVATE_MASTER=true
ACTIVATE_KB_SYNC=false

# KB Sync Agent (inside n8n runtime env)
KB_GITHUB_TOKEN=replace_github_pat_with_repo_scope
N8N_PUBLIC_API_KEY=optional_n8n_api_key_for_stats
