      "parameters": {
        "promptType": "define",
        "text": "={{ $json.query }}",
        "options": {
          "systemMessage": "Ты Агент 4: генерация видео в Kling.\n\nРежимы:\n- Если запрос про создание видео: вызови инструмент KLING | Create Video.\n- Если запрос содержит task_id и просьбу проверить статус: вызови KLING | Check Status.\n\nВерни строго JSON:\n{\n  \"status\": \"ok|processing|error\",\n  \"task_id\": \"...\",\n  \"video_url\": \"...\",\n  \"report_for_manager\": \"краткий отчёт\",\n  \"raw\": {}\n}\n\nТолько JSON, без markdown."
        }
      },
      "id": "be79eb99-f08f-46eb-915d-3fefcc21215b",
      "name": "AGENT 4 | Kling",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -420,
        160
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "toolDescription": "Create video from image URL in Kling.",
        "method": "POST",
        "url": "https://api.klingai.com/v1/videos/image2video",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "valueProvider": "fieldValue",
              "value": "Bearer REPLACE_KLING_API_KEY"
            },
            {
              "name": "Content-Type",
              "valueProvider": "fieldValue",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"prompt\": \"{videoPrompt}\",\n  \"image_url\": \"{imageUrl}\",\n  \"duration\": 5\n}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "videoPrompt",
              "description": "Video prompt",
              "type": "string"
            },
            {
              "name": "imageUrl",
              "description": "Source image URL",
              "type": "string"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        -160,
        320
      ],
      "id": "a4aeecfe-313a-4965-988d-7f28073063fd",
      "name": "KLING | Create Video"
    },
