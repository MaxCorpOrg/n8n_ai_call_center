{
  "name": "MEDIA_AGENT_ROUTER | Intent Router (draft)",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "router-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -840,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst text = String(input.query || input.text || input.message || '').trim();\nconst low = text.toLowerCase();\n\nconst hasAny = (arr) => arr.some((s) => low.includes(s));\n\nconst isGreeting = !text || /^(\\/start|start|старт|привет|хай|hello|hi|здарова|добрый)/i.test(low);\nconst isEngineCmd = /\\/engine\\s*(flow|gemini|pollinations)/i.test(text) || hasAny([\n  'на флоу', 'через flow', 'через гугл', 'через google', 'через gemini', 'на гемини',\n  'через pollinations', 'на pollinations', 'на полинейшнс', 'pollinations'\n]);\nconst isConfig = /\\/flowcfg\\b/i.test(text) || hasAny([\n  'model:', 'модель:', 'aspect ratio', 'соотношение', 'output resolution', 'разрешение',\n  'output format', 'формат', 'person generation', 'персонажи', 'люди'\n]);\nconst isRegen = hasAny([\n  'не нравится', 'не понрав', 'переделай', 'сделай другую', 'другую фот',\n  'ещё вариант', 'еще вариант', 'другой вариант', 'не то', 'сделай иначе', 'заново давай'\n]);\nconst isConfirmVideo = hasAny(['подтверждаю видео', 'делай видео', 'запускай видео', 'генерируй видео']);\nconst isConfirmPhoto = hasAny(['подтверждаю фото', 'делай фото', 'генерируй фото']);\nconst isImageRequest = hasAny(['фото', 'картин', 'изображ', 'аватар', 'сделай', 'создай', 'нарисуй']);\n\nlet intent = 'other';\nif (isGreeting) intent = 'greeting';\nelse if (isEngineCmd) intent = 'engine_select';\nelse if (isConfig) intent = 'config_update';\nelse if (isRegen) intent = 'regenerate';\nelse if (isConfirmVideo) intent = 'confirm_video';\nelse if (isConfirmPhoto) intent = 'confirm_photo';\nelse if (isImageRequest) intent = 'image_request';\n\nlet engine = String(input.engine || '').toLowerCase();\nif (!engine) {\n  if (/\\/engine\\s*(flow|gemini)/i.test(text) || hasAny(['на флоу', 'через flow', 'через гугл', 'через google', 'через gemini', 'на гемини'])) engine = 'flow';\n  if (/\\/engine\\s*pollinations/i.test(text) || hasAny(['через pollinations', 'на pollinations', 'на полинейшнс', 'pollinations'])) engine = 'pollinations';\n}\n\nconst autopilot = hasAny(['сделай сам', 'без заморочек', 'на твой вкус', 'как лучше', 'сам выбери']);\n\nconst qtyMatch = low.match(/(\\d{1,2})\\s*(фото|картин|изображ)/i);\nconst quantity = qtyMatch ? Number(qtyMatch[1]) : null;\n\nconst out = {\n  intent,\n  text,\n  engine_preference: engine || '',\n  autopilot,\n  quantity,\n  source: 'intent-router-v1'\n};\n\nreturn [{ json: out }];"
      },
