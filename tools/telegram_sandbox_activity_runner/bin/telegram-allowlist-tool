#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -n "${PYTHONPATH:-}" ]]; then
  export PYTHONPATH="${TOOL_ROOT}:${PYTHONPATH}"
else
  export PYTHONPATH="${TOOL_ROOT}"
fi

exec python3 -m allowlist_tool.cli "$@"
