  "nodes": [
    {
      "id": "7694016e-bcd3-467d-b372-b3b1453385b7",
      "name": "Email Followup | Manual Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "bca3b8ab-4b09-4e67-8dd8-7ed4a91a0d14",
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "email-followup-live/run",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "c4187304-59c3-40a6-8fc3-82fafc55e948",
      "name": "Email Followup | Normalize Manual Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nreturn [{\n  run_body: {\n    dry_run: !!body.dry_run,\n    force_resend: !!body.force_resend,\n    sheet_prefix: String(body.sheet_prefix || ''),\n    limit_sheets: Number(body.limit_sheets || 0),\n    max_records: Number(body.max_records || 0),\n  },\n}];"
      }
    },
    {
      "id": "cd7075dc-20a1-4a4f-8e59-176fbe14683a",
      "name": "Email Followup | Run Manual Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.EMAIL_FOLLOWUP_URL || 'http://127.0.0.1:8791') + '/run' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $env.EMAIL_FOLLOWUP_AUTH_TOKEN ? 'Bearer ' + $env.EMAIL_FOLLOWUP_AUTH_TOKEN : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.run_body }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "94addb6e-061f-481d-b9e0-1c76cad43cac",
      "name": "Email Followup | Build Manual Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nreturn [body];"
      }
    },
    {
      "id": "c9eb2e69-370f-402a-8fca-c061031d4baf",
      "name": "Email Followup | Respond Manual",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1280,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
