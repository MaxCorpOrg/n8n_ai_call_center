      "typeVersion": 2,
      "position": [
        500,
        520
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nreturn [{\n  run_body: {\n    dry_run: !!body.dry_run,\n    force_resend: !!body.force_resend,\n    sheet_prefix: String(body.sheet_prefix || ''),\n    limit_sheets: Number(body.limit_sheets || 0),\n    max_records: Number(body.max_records || 0),\n  },\n}];"
