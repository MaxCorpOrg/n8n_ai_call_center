    {
      "parameters": {
        "jsCode": "const data = $json.body ?? $json;\nconst settings = data.settings ?? {};\nconst ok = data.ok !== false;\nreturn [{\n  chat_id: $('Parse Agent Decision').item.json.chat_id || '',\n  reply_text: ok\n    ? [\n        'Настройки сохранены.',\n        `Город: ${settings.city || 'Москва'}`,\n        `Лимит: ${settings.count || 45}`,\n        '',\n        'Теперь можно написать:',\n        `найди ${settings.count || 45} косметологов в ${settings.city || 'Москве'}`,\n      ].join('\\n')\n    : `Не удалось сохранить настройки.\\nОшибка: ${data.error || 'неизвестно'}`,\n}];"
      },
      "id": "cd377db0-dd90-42b5-9b5a-d1233623f965",
      "name": "Build Settings Saved Reply",
