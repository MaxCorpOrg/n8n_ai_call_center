    {
      "parameters": {
        "jsCode": "const data = $json.body ?? $json;\nconst settings = data.settings ?? {};\nreturn [{\n  chat_id: $('Parse Agent Decision').item.json.chat_id || '',\n  reply_text: [\n    'Текущие настройки агента:',\n    `Город: ${settings.city || 'Москва'}`,\n    `Лимит: ${settings.count || 45}`,\n    settings.source_spreadsheet_id ? `Исходная таблица: ${settings.source_spreadsheet_id}` : '',\n    '',\n    'Команды:',\n    '/city <город>',\n    '/count <число>',\n    '/settings',\n    'Или просто напишите: найди 30 косметологов в Казани',\n  ].filter(Boolean).join('\\n'),\n}];"
      },
