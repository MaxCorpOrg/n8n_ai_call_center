# Reuse values from .env.https (DOMAIN_NAME, SSL_EMAIL, GENERIC_TIMEZONE, N8N_ENCRYPTION_KEY)

POSTGRES_DB=call_center
POSTGRES_USER=call_center
POSTGRES_PASSWORD=change_me_strong_password

# Telephony provider API (Mango/Zadarma/other)
TELEPHONY_API_BASE=https://api.example-telephony.ru/v1
TELEPHONY_API_TOKEN=replace_with_real_token
TELEPHONY_FROM=74950000000

# Secret token for provider -> n8n webhooks
CALL_EVENT_TOKEN=replace_with_random_secret
